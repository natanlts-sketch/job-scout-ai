# App
APP_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///data/jobs.db
# For production Postgres:
# DATABASE_URL=postgresql://user:pass@localhost:5432/jobscout

# Optional email settings
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_google_app_password
EMAIL_TO=your_email@gmail.com

# Anthropic AI (optional — app works without this)
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-20250514
AI_DAILY_TOKEN_BUDGET=100000

# Encryption key for sensitive settings (Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=
